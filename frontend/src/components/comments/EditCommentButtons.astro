---
const { buttonsCommentTraductions, lang } = Astro.props;
const { isReply } = Astro.props;
---

<div
  role="button"
  aria-haspopup="menu"
  class={`${isReply ? "reply-config top-2 right-2" : "comment-config top-3 right-3"} edit-trigger absolute flex h-8 w-8 cursor-pointer flex-col items-center justify-center gap-[3px] rounded-full transition-colors duration-150`}
>
  <div class="h-1 w-1 rounded-full bg-black opacity-70"></div>
  <div class="h-1 w-1 rounded-full bg-black opacity-70"></div>
  <div class="h-1 w-1 rounded-full bg-black opacity-70"></div>
</div>

<div
  role="menu"
  class={`${isReply ? "reply-config-menu top-10 right-2" : "comment-config-menu top-12 right-3"} edit-menu hidden absolute z-20 min-w-[8rem] overflow-hidden rounded-xl border border-lightBrown bg-background text-sm text-black shadow-lg`}
>
  <ul class="py-1">
    <li>
      <button class="w-full px-4 py-2 text-left font-medium transition-colors hover:bg-smoothBrown">
        {buttonsCommentTraductions[lang].edit}
      </button>
    </li>
    <li>
      <button class="w-full px-4 py-2 text-left font-medium text-red transition-colors hover:bg-smoothBrown">
        {buttonsCommentTraductions[lang].delete}
      </button>
    </li>
  </ul>
</div>

<style>
  .edit-trigger:hover {
    background-color: color-mix(in srgb, var(--color-black) 10%, transparent);
  }

  .edit-menu:not(.hidden) {
    animation: menuIn 0.16s ease-out both;
    transform-origin: top right;
  }

  .edit-menu.closing {
    animation: menuOut 0.12s ease-in both;
    transform-origin: top right;
    pointer-events: none;
  }

  @keyframes menuOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.95) translateY(-4px);
    }
  }

  @keyframes menuIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(-4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edit-menu:not(.hidden) {
      animation: none;
    }
  }
</style>
