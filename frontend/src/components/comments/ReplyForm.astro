---
interface Props {
  buttonsCommentTraductions: any;
  lang: string;
}

const { buttonsCommentTraductions, lang } = Astro.props;
---

<!-- Formulario de respuesta (oculto por defecto) -->
<div class="reply-form hidden px-4 py-3 bg-[color-mix(in_srgb,var(--color-black)_7%,transparent)] border-t border-lightBrown text-black">
  <div class="flex space-x-2">
    <textarea
      class="reply-textarea flex-1 p-2 text-sm bg-background text-black border border-salmon rounded-md resize-none focus:outline-none focus:ring-2 focus:ring-[var(--color-red)]"
      placeholder={buttonsCommentTraductions[lang].reply + "..."}
      rows="2"></textarea>
  </div>
  <div class="flex justify-end space-x-2 mt-2">
    <button class="cancel-reply-btn px-3 py-1 text-xs rounded-md hover:bg-salmon transition-colors">
      {buttonsCommentTraductions[lang].cancel}
    </button>
    <button
      class="submit-reply-btn px-3 py-1 text-xs bg-lightRed text-white rounded-md hover:bg-[var(--color-red)] transition-colors"
    >
      {buttonsCommentTraductions[lang].send}
    </button>
  </div>
</div>

<style>
  .reply-form:not(.hidden) {
    animation: replyFormIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: top;
  }

  @keyframes replyFormIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scaleY(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scaleY(1);
    }
  }

  .reply-form.closing {
    animation: replyFormOut 0.2s cubic-bezier(0.4, 0, 1, 1) both;
    transform-origin: top;
    pointer-events: none;
  }

  @keyframes replyFormOut {
    from {
      opacity: 1;
      transform: translateY(0) scaleY(1);
    }
    to {
      opacity: 0;
      transform: translateY(-8px) scaleY(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reply-form:not(.hidden) {
      animation: none;
    }
  }

  /* Estilo para el textarea de respuesta */
  .reply-textarea:focus {
    outline: none;
    border-color: var(--color-red);
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.1);
  }
</style>
