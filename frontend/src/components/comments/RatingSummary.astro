---
import StarGroup from "./StarGroup.astro";
import StarIcon from "@/assets/star.svg";
import type { CommentI18n } from "@/types/types";

interface Props {
  average: number;
  total: number;
  distribution: number[];
  lang: string;
  data: CommentI18n;
}

const { average, total, distribution, lang, data } = Astro.props;

const pluralCategory = new Intl.PluralRules(lang).select(total);
const reviewsLabel = (pluralCategory === "one" ? data.summary.review_one : data.summary.review_other).replace(
  "{count}",
  total.toString(),
);
---

<section class="rounded-2xl border border-lightBrown bg-smoothBrown p-6 text-black shadow-sm sm:p-10">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-70">{data.summary.title}</p>

  {
    total > 0 ? (
      <div class="mt-6 grid grid-cols-1 items-center gap-8 md:grid-cols-[auto_1fr] md:gap-14">
        <div class="text-center md:text-left">
          <p class="font-display font-semibold leading-none">
            <span class="text-7xl sm:text-8xl">{average.toFixed(1)}</span>
            <span class="text-2xl opacity-50">/5</span>
          </p>
          <div class="mt-4">
            <StarGroup star={average} size={26} align="justify-center md:justify-start" />
          </div>
          <p class="mt-3 text-sm opacity-70">{reviewsLabel}</p>
        </div>

        <ul class="space-y-2.5">
          {distribution.map((count, i) => {
            const stars = 5 - i;
            const percentage = Math.round((count / total) * 100);
            return (
              <li class="flex items-center gap-3 text-sm">
                <span class="flex w-8 shrink-0 items-center justify-end gap-1 font-medium tabular-nums">
                  {stars}
                  <StarIcon class="text-[#F29C2C]" width={12} height={12} />
                </span>
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--color-black)_14%,transparent)]">
                  <div class="h-full rounded-full bg-salmon" style={`width: ${percentage}%`} />
                </div>
                <span class="w-10 shrink-0 text-right tabular-nums opacity-70">{percentage}%</span>
              </li>
            );
          })}
        </ul>
      </div>
    ) : (
      <p class="mt-6 font-display text-xl leading-relaxed sm:text-2xl">{data.summary.empty}</p>
    )
  }

  <div class="mt-8 flex border-t border-lightBrown pt-6 sm:justify-end">
    <button
      id="open-comment-modal"
      class="w-full rounded-lg bg-red px-8 py-3.5 text-base font-semibold text-gray-50 transition-colors duration-200 hover:bg-lightRed sm:w-auto"
    >
      {data.button}
    </button>
  </div>
</section>
