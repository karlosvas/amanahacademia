---
import Title from "../common/Title.astro";
---

<div id="app-config" class="container h-screen">
  <div class="card">
    <Title customStyleText="text-xl sm:text-2xl" customStyleLine="w-20 mb-6">
      Finaliza tu inscripción<span class="ml-2" id="pricing"></span>
    </Title>

    <!-- Mensajes de estado -->
    <div id="error-message" class="message error-message"></div>

    <!-- Contenedor para los elementos de pago -->
    <div id="payment-element-container">
      <div class="loading">Inicializando pasarela de pago...</div>
      <div id="payment-element"></div>
    </div>

    <button id="submit-button" type="button" disabled>
      <span id="button-text">Pagar ahora</span>
    </button>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
  import { buildCheckoutRequest, createCheckout, handlePayment, initializeStripe, showError } from "@/services/payment";
  import { getErrorFrontStripe, FrontendStripe } from "@/enums/enums";
  import { getCurrentUserToken, onAuthStateChanged } from "@/services/firebase";
  import { log } from "@/services/logger";
  import { showModalAnimation } from "@/utils/modals";

  const STRIPE_PUBLIC_KEY = import.meta.env.PUBLIC_STRIPE_API_KEY;

  const params = new URLSearchParams(globalThis.location.search);
  const checkoutRequest = buildCheckoutRequest(params);
  const testCountry: string | null = import.meta.env.DEV ? params.get("test_country") : null;

  const redirectHomeLater = () => {
    setTimeout(() => {
      globalThis.location.href = "/";
    }, 5000);
  };

  let checkoutStarted = false;

  const startCheckout = async () => {
    if (!checkoutRequest) {
      log.error("Missing URL parameters, redirecting to home page.");
      showError(getErrorFrontStripe(FrontendStripe.MISSING_URL_PARAMS));
      redirectHomeLater();
      return;
    }

    const token = await getCurrentUserToken();
    if (!token) {
      showError(getErrorFrontStripe(FrontendStripe.GENERIC_ERROR));
      return;
    }

    const checkout = await createCheckout(token, checkoutRequest, testCountry);
    if (!checkout) return;

    const pricingElement = document.getElementById("pricing");
    if (pricingElement) pricingElement.textContent = ` ${(checkout.amount / 100).toFixed(2)} €`;

    const result = await initializeStripe(STRIPE_PUBLIC_KEY, checkout.client_secret);
    if (!result) return;

    const submitButton = document.getElementById("submit-button");
    submitButton?.addEventListener("click", () =>
      handlePayment(result.stripe, result.elements, checkout.client_secret),
    );
  };

  document.addEventListener("DOMContentLoaded", () => {
    if (!STRIPE_PUBLIC_KEY) {
      showError(getErrorFrontStripe(FrontendStripe.MISSING_CONFIG));
      return;
    }

    onAuthStateChanged((user) => {
      if (user) {
        if (checkoutStarted) return;
        checkoutStarted = true;
        void startCheckout();
      } else {
        log.error("User not authenticated for payment, redirecting to login modal");

        // Mostrar modal de autenticación
        const modalAuth = document.getElementById("authModalLogin");
        const form = document.getElementById("loginForm");

        if (!(modalAuth instanceof HTMLDialogElement)) {
          log.error("Auth login modal not found in DOM");
          showError(getErrorFrontStripe(FrontendStripe.MISSING_ELEMENTS));
          return;
        }

        const loginForm = form instanceof HTMLFormElement ? form : null;

        const openLoginModal = () => {
          if (modalAuth.open) return;

          try {
            showModalAnimation(modalAuth, loginForm, true);
          } catch (error) {
            log.error("Failed to open auth modal with animation", error);
            modalAuth.showModal();
          }
        };

        openLoginModal();

        // Si no hay sesión, no permitir cerrar el modal de login.
        const reopenIfUnauthenticated = async () => {
          const token = await getCurrentUserToken();
          if (!token) {
            setTimeout(() => {
              openLoginModal();
            }, 0);
          }
        };

        if (modalAuth.dataset.paymentAuthLock !== "true") {
          modalAuth.dataset.paymentAuthLock = "true";

          modalAuth.addEventListener("close", () => {
            void reopenIfUnauthenticated();
          });

          modalAuth.addEventListener("cancel", (event) => {
            event.preventDefault();
            void reopenIfUnauthenticated();
          });
        }
      }
    });
  });
</script>

<style>
  .container {
    max-width: 600px;
    margin: 50px auto;
    padding: 20px;
    font-family: Arial, sans-serif;
  }

  .card {
    border-radius: 8px;
    padding: 30px;
  }

  h1 {
    text-align: center;
    color: #333;
    margin-bottom: 30px;
  }

  .message {
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 20px;
    display: none;
  }

  .success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .error-message {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  #payment-element {
    margin: 20px 0;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    min-height: 40px;
  }

  .loading {
    text-align: center;
    color: #666;
    padding: 20px;
  }

  #submit-button {
    width: 100%;
    background-color: var(--color-salmon);
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
    margin-top: 20px;
  }

  #submit-button:disabled {
    background-color: #aaa;
    cursor: not-allowed;
  }

  #submit-button:hover:not(:disabled) {
    background-color: var(--color-light-brown);
  }
</style>
