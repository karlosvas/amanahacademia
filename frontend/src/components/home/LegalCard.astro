---
const { colourRectangle } = Astro.props;
---

<div class="bg-lightSalmon p-4 sm:p-5 rounded-md m-auto md:m-3 w-full max-w-sm sm:max-w-md text-center">
  <div class=`${colourRectangle} w-10 h-10 rounded-full flex items-center justify-center m-auto`>
    <slot name="icon" />
  </div>
  <h3 class="font-display p-3 text-red text-lg font-semibold"><slot name="title" /></h3>
  <p class="text-sm sm:text-base leading-relaxed">
    <slot name="description" />
  </p>
</div>
