---
import AboutUs from "@/components/home/AboutUs.astro";
import { Image } from "astro:assets";
import banner from "@/assets/img/banner.webp";
import type { HomeI18n } from "@/types/types";

const data = Astro.props.data as HomeI18n;
---

<section class="relative w-full">
  <div
    class="scroll-fade-in absolute top-0 left-0 w-full h-full overflow-hidden rounded-none shadow-[0_0_10px_0_rgba(255,120,60,0.5)] m-0 p-0 z-0"
  >
    <Image
      src={banner}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      widths={[350, 525, 700, 1050]}
      sizes="(max-width: 640px) 350px, 525px"
      class="w-full h-full object-cover object-top m-0 p-0"
      loading="eager"
      decoding="sync"
    />
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(circle at center, rgba(255,120,60,0.35) 0%, transparent 70%);"
    >
    </div>
  </div>
  <h1
    class="scroll-fade-in text-center px-6 pt-20 pb-1 text-red font-display font-semibold tracking-tight leading-tight text-4xl sm:text-5xl md:text-6xl select-none z-20 relative"
  >
    Amanah Academia
  </h1>
  <div class="title-line bg-salmon h-1.5 sm:h-2 rounded-full m-auto mb-8 w-48 sm:w-80 mt-3 z-20 relative"></div>
  <h2 class="scroll-fade-in text-center mx-6 my-8 text-red font-display font-medium text-xl sm:text-2xl leading-snug z-20 relative pb-20">
    Del primer hola a todo un mundo <br /> <span class="font-sans text-base sm:text-lg font-semibold text-gray-700">Academia de Español</span>
  </h2>
</section>

<AboutUs data={data} />

<p class="max-w-3xl mx-auto my-10 px-4 sm:px-6 text-red text-center text-sm sm:text-base leading-relaxed font-medium scroll-fade-in">
    {data.focus.note.map((note, _) => <span >{note}</span> <br />)}
</p>
